# VulnHunter local env (copy to backend/.env or repo root .env)
# Listen ports for start.cmd / start.sh (defaults avoid crowded 8000 / 5173)
# VULNHUNTER_PORT=16780
# VULNHUNTER_FRONTEND_PORT=15173
VULNHUNTER_HTTP_PROXY=http://127.0.0.1:10808
VULNHUNTER_HTTPS_PROXY=http://127.0.0.1:10808
# Chat Completions 默认直连；仅在必须走代理时取消下一行注释
# VULNHUNTER_CHAT_PROXY=http://127.0.0.1:10808
# OPENAI_API_KEY=
# GITHUB_TOKEN=
